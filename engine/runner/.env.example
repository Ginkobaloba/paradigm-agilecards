# Copy to .env (gitignored) next to where you run `cards-runner`, or point
# CARDS_RUNNER_ENV_FILE at it. Values here are placeholders only.
# A variable already set in the environment wins over this file.

# Needed for --invoker sdk/sdk-tools and for live LLM reviews. Without it the
# daemon still runs, logs "LLM reviews DEGRADED" at boot, and
# `cards-runner status` says so.
ANTHROPIC_API_KEY=

# All-local runs. `--invoker sdk` starts WITHOUT ANTHROPIC_API_KEY only when
# every tier of the map below routes to a keyless local provider (ollama/,
# vllm/, local/). A SET map path is a pin: if the file is missing or broken the
# runner refuses (at start) or the card lands blocked (mid-run); it never falls
# back to the Claude map. Relative paths are made absolute at start.
# CARDS_RUNNER_TIER_MAP_YAML=C:\dev\paradigm-agilecards\engine\tier_map_local.yaml

# Local endpoints. These are forwarded to every worker as-is, so they must be
# ENDPOINTS ONLY: http(s)://host[:port][/path]. Userinfo, query strings,
# fragments and ';' parameters are refused at start. Paths are allowed, so do
# not put a token in the path either; keyless local servers need none.
# CARDS_RUNNER_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# CARDS_RUNNER_VLLM_BASE_URL=
# CARDS_RUNNER_LOCAL_BASE_URL=
