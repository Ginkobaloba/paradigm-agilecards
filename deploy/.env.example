# Copy to deploy/.env and fill in. NEVER commit the real .env.
# Generate passwords: openssl rand -base64 24  (or PowerShell:
#   [Convert]::ToBase64String((1..24 | % { Get-Random -Max 256 })) )

POSTGRES_SUPERUSER_PASSWORD=change-me
CARDS_OWNER_PASSWORD=change-me
CARDS_APP_PASSWORD=change-me

# Paradigm IdP (public config, defaults baked in — override for staging IdP)
#PARADIGM_JWT_ISSUER=https://auth.paradigm.codes
#PARADIGM_JWT_AUDIENCE=paradigm-agilecards
#PARADIGM_JWKS_URL=

# "env" (default) or "infisical" (production; also set INFISICAL_* vars)
#PARADIGM_SECRETS_PROVIDER=env

# Where compose publishes the front door on the host.
#PUBLISH_ADDRESS=127.0.0.1:8080
# ":80" behind the Cloudflare tunnel; a real hostname for Caddy auto-HTTPS.
#SITE_ADDRESS=:80
# "/" at the root; "/board/" when served under the portal path prefix.
#VITE_BASE_PATH=/
