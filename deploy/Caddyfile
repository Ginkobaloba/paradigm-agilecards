# Front door: static Boards UI + same-origin API proxy.
# SITE_ADDRESS=":80" behind the Cloudflare tunnel (edge terminates TLS), or
# a real hostname (e.g. "cards.paradigm.codes") for Caddy automatic HTTPS.
{$SITE_ADDRESS}

encode gzip

# HSTS only does something over TLS; harmless behind the tunnel.
header {
	Strict-Transport-Security "max-age=31536000; includeSubDomains"
	X-Content-Type-Options "nosniff"
	Referrer-Policy "strict-origin-when-cross-origin"
}

handle /api/* {
	reverse_proxy api:8000
}

handle /events {
	# SSE: disable buffering so events flush immediately.
	reverse_proxy api:8000 {
		flush_interval -1
	}
}

handle /healthz {
	reverse_proxy api:8000
}

handle {
	root * /srv
	try_files {path} /index.html
	file_server
}
